# ============================================================
# TravelMind 环境配置
# ============================================================
# 
# 配置说明:
#   【必须】- 没有则无法运行
#   【推荐】- 影响核心功能，建议配置
#   【可选】- 不配置也能运行
#
# 本地开发快速开始:
#   1. cp .env.example .env
#   2. 填写 DASHSCOPE_API_KEY（必须）
#   3. 填写 AMAP_API_KEY（推荐）
#   4. make dev 或 docker-compose -f docker-compose.local.yml up -d
#
# ============================================================

# -------------------------------------------
# 基础配置【可选】- 都有合理默认值
# -------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# -------------------------------------------
# 【必须】LLM 配置 - 通义千问
# -------------------------------------------
# 获取地址: https://bailian.console.aliyun.com/
# 新用户免费: 100 万 tokens
# 
# ⚠️  没有这个配置，项目无法运行！
DASHSCOPE_API_KEY=sk-your-api-key-here

# 模型选择（可选，使用默认值即可）
# LLM_MODEL=qwen-turbo        # 日常使用，便宜
# LLM_MODEL=qwen-plus         # 复杂任务，更强

# -------------------------------------------
# 【推荐】高德地图 API
# -------------------------------------------
# 获取地址: https://lbs.amap.com/
# 免费额度: 每日 30 万次调用
#
# 提供功能: POI 搜索、天气查询、路线规划
# 不配置则这些功能不可用
AMAP_API_KEY=your-amap-key-here

# -------------------------------------------
# 【可选】博查搜索 API
# -------------------------------------------
# 获取地址: https://open.bochaai.com/
#
# 提供功能: 网络搜索（旅游攻略、新闻等）
# 不配置则搜索功能不可用
BOCHA_API_KEY=your-bocha-key-here

# -------------------------------------------
# 【可选】Langfuse 可观测性
# -------------------------------------------
# 用于追踪 LLM 调用，分析成本和性能
# 不配置也能正常运行，只是没有监控
#
# 自托管方式（推荐，数据私有，无需注册）:
#   1. docker-compose -f docker-compose.langfuse.yml up -d
#   2. 访问 http://localhost:3000 创建本地账号
#   3. 创建项目，获取 API Keys
#   详见: docs/LANGFUSE_SELF_HOST.md
#
# LANGFUSE_PUBLIC_KEY=pk-lf-xxx
# LANGFUSE_SECRET_KEY=sk-lf-xxx
# LANGFUSE_HOST=http://localhost:3000

# -------------------------------------------
# 向量数据库【可选】- 使用默认值即可
# -------------------------------------------
# Chroma 本地文件存储，无需额外配置
# CHROMA_PERSIST_DIR=./data/chroma

# -------------------------------------------
# 以下配置【当前未使用】- 为未来扩展预留
# -------------------------------------------
# Redis 缓存（预留：会话缓存、限流）
# REDIS_URL=redis://localhost:6379/0

# 数据库（预留：用户系统、历史记录）
# DATABASE_URL=sqlite:///./data/travelmind.db

# JWT 认证（预留：用户认证系统）
# SECRET_KEY=your-secret-key

# CORS（前端跨域，有默认值）
# CORS_ORIGINS=["http://localhost:3000"]
